# ============================================================
# TrustFund — Environment Variables Template
# Salin file ini ke .env dan isi nilainya.
# JANGAN commit file .env ke Git! (private key = kontrol wallet & dana)
# ============================================================

# ── Wallet & Keys ───────────────────────────────────────────
# Private key deployer. JANGAN pakai personal wallet —
# gunakan dedicated deployer wallet. Wajib punya gas (POL/MATIC).
DEPLOYER_PRIVATE_KEY=

# Hot wallet backend relayer TrustFund.
BACKEND_WALLET=

# Multisig admin (DEFAULT_ADMIN_ROLE). Gnosis Safe direkomendasikan.
ADMIN_MULTISIG=

# ── Token ───────────────────────────────────────────────────
# Alamat XIDR di jaringan target.
# Kosongkan di lokal — script otomatis deploy MockXIDR sendiri.
# Isi di testnet/mainnet dengan alamat token yang sesuai.
XIDR_TOKEN_ADDRESS=

# ── RPC URLs ────────────────────────────────────────────────
# Gunakan provider yang andal (Alchemy / Infura / QuickNode).
# Testnet (Polygon Amoy) — jika kosong, fallback ke RPC publik.
AMOY_RPC_URL=

# Mainnet (Polygon) — hanya perlu untuk deploy mainnet.
POLYGON_RPC_URL=

# ── Upgrades ────────────────────────────────────────────────
# Alamat proxy yang sudah ter-deploy, diperlukan untuk upgrade:*
PROXY_ADDRESS=

# ── API Keys (opsional) ─────────────────────────────────────
# Verifikasi contract di PolygonScan (untuk verify:*).
POLYGONSCAN_API_KEY=

# Harga gas dalam fiat pada gas report (opsional).
CMC_API_KEY=